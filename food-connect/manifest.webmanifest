{
  "id": "/food-connect/",
  "name": "Food Connect",
  "short_name": "Food Connect",
  "description": "Order from local restaurants in your town. We buy your food and deliver it to your door.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./shop.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#18251f",
  "theme_color": "#18251f",
  "categories": ["food", "shopping"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Order food",
      "short_name": "Order",
      "description": "Pick a restaurant and start an order",
      "url": "./shop.html?source=shortcut#restaurants",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Fees and how it works",
      "short_name": "Fees",
      "description": "See service and delivery fees",
      "url": "./index.html?source=shortcut#fees",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "prefer_related_applications": false
}
